### 6. COHORTES Y PROGRAMACIÓN MODULAR (Control de Quórum y Horarios)
### ------------------------------------------------------------------------------

# @name createCohort
POST {{baseUrl}}/cohorts
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "programa_id": "{{programId}}",
  "sede_id": "{{sedeId}}",
  "modalidad": "SEMIPRESENCIAL",
  "codigo_cohorte": "MGS-2026-I-MGA",
  "numero_edicion": 1,
  "coordinador_id": "{{docenteId}}",
  "fecha_inicio_inscripcion": "2026-01-01",
  "fecha_fin_inscripcion": "2026-03-01",
  "fecha_inicio_clases": "2026-03-15",
  "fecha_fin_clases": "2028-03-15",
  "horario_general": "Sábados de 8:00 AM a 2:00 PM",
  "precio_matricula": 150,
  "precio_total_cohorte": 3600,
  "cupo_minimo": 2,
  "cupo_maximo": 30,
  "estado_cohorte": "INSCRIPCION_ABIERTA"
}

