  "requiere_revista_indexada": true,
  "titulo_o_certificado_otorgado": "Máster en Gestión y Epidemiología de Salud Pública",
  "abreviatura_grado": "M.Sc."
}

###
@programId = {{createProgram.response.body.data.id}}

# @name assignTagsToProgram
POST {{baseUrl}}/programs/{{programId}}/tags
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "tag_ids": ["{{tagId}}"]
}

###

# @name createComponenteMalla
POST {{baseUrl}}/programs/{{programId}}/componentes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "codigo": "MOD-EPI-01",
  "nombre": "Bioestadística y Epidemiología Aplicada",
  "descripcion_temario": "Modelos probabilísticos, análisis multivariado y diseño de estudios epidemiológicos.",
  "orden_bloque": 1,
  "horas": 60,
  "creditos": 4,
  "es_investigacion": false,
  "costo_base_asignatura": 250
}

###
@componenteId = {{createComponenteMalla.response.body.data.id}}

# @name getPublicCatalog
GET {{baseUrl}}/programs/catalog?categoria=POSGRADO

