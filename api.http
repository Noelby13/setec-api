### ------------------------------------------------------------------------------
### 10. CALIFICACIONES SNEPA (Importación Excel, Modificación y Auditoría)
### ------------------------------------------------------------------------------

# @name importGradesExcel
POST {{baseUrl}}/grades/import/{{programacionComponenteId}}
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundaryExcelSnepa

------WebKitFormBoundaryExcelSnepa
Content-Disposition: form-data; name="archivo_excel"; filename="plantilla_acta_snepa.xlsx"
Content-Type: application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

< ./uploads/actas_excel/plantilla_acta_snepa.xlsx
------WebKitFormBoundaryExcelSnepa
Content-Disposition: form-data; name="observaciones"

Acta de calificaciones finales Módulo I SNEPA
------WebKitFormBoundaryExcelSnepa--

###

# @name getGradesByComponent
GET {{baseUrl}}/grades/component/{{programacionComponenteId}}
Authorization: Bearer {{token}}

###
@matriculaComponenteId = {{getGradesByComponent.response.body.data[0].id}}

# @name modifyGradeManualWithAudit
PATCH {{baseUrl}}/grades/{{matriculaComponenteId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "motivo_modificacion": "Ajuste posterior a revisión formal de informe epidemiológico de campo.",
  "calificacion_cuantitativa": 98.0,
  "valoracion_cualitativa": "APRENDIZAJE_AVANZADO",
  "observacion_acompanamiento_pedagogico": "Desempeño sobresaliente con publicación recomendada."
}

###

# @name getGradeAuditLogs
GET {{baseUrl}}/grades/{{matriculaComponenteId}}/logs
Authorization: Bearer {{token}}

###

# @name getStudentKardex
GET {{baseUrl}}/grades/student/{{enrollmentId}}
Authorization: Bearer {{token}}

### ------------------------------------------------------------------------------
### 11. EXPEDIENTE DE GRADUACIÓN, INVESTIGACIÓN Y VERIFICACIÓN QR
### ------------------------------------------------------------------------------

# @name createGraduationExpediente
POST {{baseUrl}}/graduation/expediente
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "inscripcion_id": "{{enrollmentId}}",
  "tipo_documento_final": "TITULO_POSGRADO",
  "idioma_acreditado": "Inglés Técnico Médico",
  "nivel_idioma_alcanzado": "B1",
  "institucion_aval_idioma": "Centro de Idiomas Extranjeros Universitario",
  "modalidad_graduacion_tipo": "TESIS_EPIDEMIOLOGICA",
  "titulo_trabajo_graduacion": "Vigilancia Epidemiológica de Arbovirosis en el Corredor Seco de Nicaragua",
  "aplico_salida_intermedia": false
}

###
@expedienteId = {{createGraduationExpediente.response.body.data.id}}

# @name registerScientificPublication
POST {{baseUrl}}/graduation/expediente/{{expedienteId}}/publications
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "tipo_publicacion": "ARTICULO_CIENTIFICO",
  "titulo_publicacion": "Patrones espacio-temporales del Dengue en Managua: Un enfoque comunitario",
  "nombre_revista_o_medio": "Revista Panamericana de Salud Pública",
  "es_revista_indexada": true,
  "tiene_revision_pares": true,
  "alcance": "INTERNACIONAL",
  "url_o_doi": "https://doi.org/10.26633/RPSP.2026.42"
}

###
@publicationId = {{registerScientificPublication.response.body.data.id}}

# @name validateScientificPublication
PATCH {{baseUrl}}/graduation/publications/{{publicationId}}/validate
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "validado_coordinacion": true
}

###

# @name updateExpedienteRequisitos
PATCH {{baseUrl}}/graduation/expediente/{{expedienteId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "idioma_validado": true
}

###

# @name issueOfficialDegree
POST {{baseUrl}}/graduation/expediente/{{expedienteId}}/issue
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "codigo_registro_titulo_emitido": "SETEC-POS-2026-0001",
  "fecha_emision": "2026-12-15",
  "tipo_documento_final": "TITULO_POSGRADO"
}

###
@codigoRegistroEmitido = {{issueOfficialDegree.response.body.data.codigo_registro_titulo_emitido}}

