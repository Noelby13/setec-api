### ------------------------------------------------------------------------------
### 8. INSCRIPCIÓN Y QUÓRUM TRANSACCIONAL
### ------------------------------------------------------------------------------

# @name createEnrollment
POST {{baseUrl}}/enrollments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "aspirante_id": "{{applicantId}}",
  "cohorte_id": "{{cohortId}}",
  "titulo_presentado_id": "{{degreeId}}",
  "rol_participacion": "ESTUDIANTE_EVALUADO"
}

###
@enrollmentId = {{createEnrollment.response.body.data.id}}
@codigoExpediente = {{createEnrollment.response.body.data.codigo_expediente}}

# @name validateDocumentsAndQuorum
PATCH {{baseUrl}}/enrollments/{{enrollmentId}}/validate-documents
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "aprobado": true,
  "observaciones_administracion": "Documentos validados según requerimientos SETEC Art. 60"
}

