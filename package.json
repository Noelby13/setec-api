{
  "name": "posgrado-setec-api",
  "version": "1.0.0",
  "description": "API REST SNEPA-SETEC para gesti\u00f3n de posgrados y educaci\u00f3n permanente",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "seed": "tsx src/db/seed.ts",
    "gen:excel": "tsx src/scripts/generate-snepa-template.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test:auth": "node --import tsx --test src/modules/auth/*.test.ts src/modules/users/*.test.ts",
    "test": "node --import tsx --test src/middlewares/*.test.ts src/modules/auth/*.test.ts src/modules/users/*.test.ts src/modules/applicants/*.test.ts src/modules/enrollments/*.test.ts src/modules/graduation/*.test.ts src/modules/certificates/*.test.ts src/modules/billing/*.test.ts",
    "contracts:check": "node scripts/sync-contracts.mjs --check",
    "contracts:sync": "node scripts/sync-contracts.mjs --write",
    "test:certificates:integration": "node --import tsx src/modules/certificates/certificates.integration.ts",
    "test:enrollments:integration": "node --import tsx src/modules/enrollments/enrollment.integration.ts",
    "test:connected": "node scripts/connected-academic.e2e.mjs ..",
    "test:billing:integration": "node --import tsx src/modules/billing/billing.integration.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "postgresql",
    "snepa",
    "setec"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
